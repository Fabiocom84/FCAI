#!/bin/sh
#
# Gancio pre-commit del frontend — task E5, 06/09/2026.
#
# PERCHE ESISTE
# Il riesame del 23/08 (punto 7) ha trovato che tutte le discipline del progetto
# — il controllo delle impronte, la suite, la procedura in otto passi — vivevano
# nella conversazione e non nel repository. Funzionavano finche qualcuno se ne
# ricordava, e le regole avevano la vita della sessione.
#
# Il caso peggiore e gia capitato, il 22/08: `api-client.js` era stato
# modificato ma l'impronta no, quindi i browser continuavano a servire la copia
# in cache. Nessun errore, nessun avviso, e un collaudo che diceva "sembra
# funzionare" su codice che non era in esecuzione. Il 06/09 la stessa cosa si e
# ripresentata tre volte in una sola sessione, evitata solo perche qualcuno se ne
# e ricordato ogni volta.
#
# COSA CONTROLLA
#   1. che ogni collegamento a CSS e JS porti l'impronta del contenuto ATTUALE;
#   2. che ogni `segnala(X)` stia dentro un `catch (X)` — controllo nato il
#      06/09, dopo che uno strumento ne aveva piazzati otto fuori dal blocco e
#      la cosa era arrivata in staging.
#
# COME SI INSTALLA
#   python strumenti/installa_ganci.py
#
# I ganci NON sono versionati da git (vivono in `.git/hooks/`), quindi questo
# file sta in `strumenti/` e l'installatore lo copia. Chi clona il repository
# deve eseguire l'installatore una volta: e un passo in piu, ma e l'unico modo
# di far viaggiare un gancio insieme al codice.
#
# COME SI SCAVALCA, quando serve davvero
#   git commit --no-verify
# Legittimo per un commit di soli documenti. Se serve spesso, il gancio e
# sbagliato e va corretto, non aggirato.

set -e

echo "── pre-commit ─────────────────────────────────────────"

# QUALE PYTHON — aggiunto il 06/09/2026, prima che il gancio rompesse tutto.
#
# La prima stesura invocava `python` e basta. Su Windows quel nome esiste solo
# se il PATH e stato configurato o se un ambiente virtuale e attivo: i ganci git
# girano in una shell PROPRIA, senza `.venv`, quindi il gancio avrebbe fallito a
# OGNI commit con "Python non e stato trovato".
#
# Un gancio che blocca sempre e peggio di uno assente: chi lo subisce impara a
# usare `--no-verify` per abitudine, e da quel momento non protegge piu niente —
# ma resta li a dare l'impressione di proteggere.
#
# Scoperto perche l'installazione e fallita a mano. Se fosse riuscita su una
# shell con il venv attivo, il difetto sarebbe comparso al primo commit fatto
# altrove, senza alcun legame visibile con questo file.
PY=""
for candidato in python3 python py; do
    if command -v "$candidato" >/dev/null 2>&1 && "$candidato" -c "import sys" >/dev/null 2>&1; then
        PY="$candidato"
        break
    fi
done

if [ -z "$PY" ]; then
    echo ""
    echo "✗ COMMIT INTERROTTO: nessun interprete Python utilizzabile."
    echo ""
    echo "  Provati: python3, python, py — nessuno risponde."
    echo "  I ganci girano in una shell propria, senza ambiente virtuale."
    echo ""
    echo "  Rimedio: installare Python nel PATH di sistema, oppure — se questo"
    echo "  blocco si ripete e non si puo risolvere subito — disinstallare il"
    echo "  gancio invece di aggirarlo ogni volta con --no-verify:"
    echo "      rm .git/hooks/pre-commit"
    echo ""
    exit 1
fi

# IL GANCIO E' AGGIORNATO? — aggiunto il 06/09/2026.
#
# I ganci vivono in `.git/hooks/`, che git non versiona: `installa_ganci.py` ne
# copia una versione. Modificare `strumenti/gancio-pre-commit` quindi NON ha
# effetto finche' qualcuno non reinstalla — e nulla lo segnala. Il giorno in cui
# si aggiunge un controllo qui e ci si dimentica di reinstallare, si continua a
# committare credendo di essere protetti da una verifica che non gira.
#
# E' avviso e non blocco: chi clona il repository non ha ancora installato
# nulla, e fermarlo al primo commit sarebbe il gancio-che-blocca-sempre
# descritto sopra.
if [ -f strumenti/gancio-pre-commit ] && ! cmp -s strumenti/gancio-pre-commit "$0"; then
    echo "⚠ il gancio installato e' diverso da strumenti/gancio-pre-commit"
    echo "  i controlli che stai vedendo NON sono quelli aggiornati."
    echo "  Rimedio:  \$PY strumenti/installa_ganci.py"
    echo ""
fi

# SEI SUL RAMO GIUSTO? — aggiunto il 06/09/2026, dopo esserci cascati.
#
# CLAUDE.md regola 9, in vigore dal 17/08/2026: ogni modifica va applicata e
# verificata ESCLUSIVAMENTE su staging; `main` e' cio' che Vercel serve in
# produzione e non si tocca senza autorizzazione esplicita e caso per caso.
#
# Quella regola viveva solo in un documento. Il 06/09 un commit e' finito su
# `main` perche' il comando dato non aveva davanti un `git checkout staging`, e
# nessuno se n'e' accorto finche' `git push origin staging` non ha risposto
# "Everything up-to-date" — un successo apparente che diceva il contrario di
# quello che sembrava. Bastava un `push origin main` fatto per abitudine e la
# produzione cambiava senza che nessuno l'avesse deciso.
#
# Le fusioni non passano da qui (git usa `pre-merge-commit`), quindi un commit
# diretto su `main` e' proprio il caso che la regola 9 vieta. Si blocca, e la
# via d'uscita e' esplicita: chi ha davvero l'autorizzazione usa --no-verify e
# sa perche' lo sta facendo.
RAMO=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
if [ "$RAMO" = "main" ] || [ "$RAMO" = "master" ]; then
    echo ""
    echo "✗ COMMIT INTERROTTO: sei sul ramo '$RAMO', cioe' la produzione."
    echo ""
    echo "  CLAUDE.md regola 9: ogni modifica si applica e si verifica su"
    echo "  staging. La produzione non si tocca senza autorizzazione esplicita."
    echo ""
    echo "  Quasi certamente volevi:  git checkout staging"
    echo "  Il lavoro non e' perso: le modifiche restano dove sono."
    echo ""
    echo "  Se l'autorizzazione ce l'hai davvero:  git commit --no-verify"
    echo ""
    exit 1
fi

# `--controlla` esce con 1 se un collegamento porta un'impronta vecchia.
if ! "$PY" strumenti/versione_css.py --controlla; then
    echo ""
    echo "✗ COMMIT INTERROTTO: vedi la causa qui sopra."
    echo ""
    # Il messaggio NON ripete una causa specifica, ed e' una correzione del
    # 06/09/2026. `versione_css.py` controlla due cose — le impronte `?v=` nelle
    # pagine e CACHE_VERSION in sw.js — e stampa da se' quale delle due sia
    # disallineata. Qui sotto c'era scritto «hai modificato un CSS o un JS senza
    # aggiornare i collegamenti», che alla prima prova reale del gancio ha
    # nominato la causa sbagliata: i collegamenti erano a posto, disallineata era
    # CACHE_VERSION. Il rimedio coincide, quindi non ha fatto danni — ma un
    # messaggio che nomina una causa diversa da quella trovata e' il modo in cui
    # si perde un'ora a guardare nel posto sbagliato, ed e' gia' costato
    # esattamente quello il 18/08 con l'allarme di sicurezza.
    echo "  In entrambi i casi il codice nuovo NON arriverebbe agli utenti, e il"
    echo "  collaudo direbbe che funziona perche' si comporta come prima."
    echo ""
    # Si nomina l'interprete TROVATO, non "python": su Windows quel nome
    # spesso non esiste, e un rimedio che non funziona sulla macchina di chi
    # lo legge e peggio di nessun rimedio — manda a cercare la causa
    # sbagliata.
    echo "  Rimedio:  $PY strumenti/versione_css.py --aggiorna"
    echo "            git add *.html"
    echo ""
    exit 1
fi

if ! "$PY" strumenti/controlla_pagine.py; then
    echo ""
    echo "✗ COMMIT INTERROTTO: una pagina non riuscirebbe a caricarsi."
    echo ""
    echo "  Import irrisolti, export di funzioni cancellate, o due proprieta'"
    echo "  con la stessa chiave nello stesso oggetto. I primi due fermano la"
    echo "  pagina; il terzo non produce alcun errore — la seconda definizione"
    echo "  sovrascrive la prima in silenzio, ed e' il motivo per cui 51 righe"
    echo "  di dashboard.js non giravano da mesi senza che nulla lo dicesse."
    echo ""
    exit 1
fi

# PROVE ESEGUIBILI — aggiunte l'09/09/2026 (task 4.10).
#
# `controlla_pagine.py` guarda la struttura; queste eseguono il codice. Servono
# `api-client.js` in particolare, da cui dipendono 23 moduli su 34: un suo
# difetto non rompe una pagina, le rompe tutte. Il primo giorno che sono
# esistite hanno trovato un 401 che eseguiva il logout tre volte con 1,5
# secondi di attesa, invisibile a settimane di riletture.
#
# Girano SOLO se `node` c'e'. Non e' pigrizia: i ganci vivono in una shell
# propria e non tutti hanno node nel PATH, e un gancio che blocca chi non puo'
# rimediare insegna `--no-verify` — dopodiche' non protegge piu' niente
# continuando a sembrare che lo faccia.
if command -v node >/dev/null 2>&1; then
    for prova in prove/*.prova.mjs; do
        [ -f "$prova" ] || continue
        if ! node "$prova" > /tmp/prova-esito.txt 2>&1; then
            echo ""
            echo "✗ COMMIT INTERROTTO: una prova eseguibile non passa."
            echo ""
            grep -E "^  ✗|casi come attesi|atteso|osservato" /tmp/prova-esito.txt | sed 's/^/  /'
            echo ""
            echo "  Esegui:  node $prova"
            echo ""
            exit 1
        fi
    done
    echo "── prove eseguibili superate ──────────────────────────"
else
    echo "⚠ node non trovato: le prove in prove/ non sono state eseguite."
fi

if ! "$PY" strumenti/verifica_segnala.py; then
    echo ""
    echo "✗ COMMIT INTERROTTO: una chiamata a segnala() e fuori posto."
    echo ""
    echo "  Una chiamata fuori dal proprio catch solleva ReferenceError a"
    echo "  runtime, su una pagina che gli utenti aprono. E' gia successo il"
    echo "  06/09/2026 ed e arrivata in staging."
    echo ""
    exit 1
fi

echo "── controlli superati ─────────────────────────────────"
